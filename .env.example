# Copy this file to .env (same folder) and fill in a key. Never commit .env.
#
# Image analysis needs ONE of the two keys below. Without any key the service
# still runs: it scores from text and reviews, and reports vision as
# "skipped_no_provider".

# --- Google Gemini (has a free tier) -------------------------------------------
# Get a key at https://aistudio.google.com/apikey and paste it after the = sign.
# FREE-TIER WARNING: Google may use free-tier uploads to improve its products and
# human reviewers may read them. Photograph garments only: no people, faces or
# personal details. Do not use the free tier for real users.
GEMINI_API_KEY=
# Model ID. Default gemini-3.5-flash (tested working on the free tier). gemini-3.8-flash
# returned 503 "high demand" when tried; gemini-2.5-flash is closed to new users.
# SEAMWISE_GEMINI_MODEL=gemini-3.5-flash

# --- Anthropic (paid) ----------------------------------------------------------
ANTHROPIC_API_KEY=
# SEAMWISE_MODEL=claude-opus-5-5

# Which provider to use when both keys are set. Default: anthropic.
# SEAMWISE_PROVIDER=gemini

# --- Server --------------------------------------------------------------------
# If set, every /v1 request must send "Authorization: Bearer <token>".
# Set this before exposing the service beyond your own machine.
# SEAMWISE_API_TOKEN=
# PORT=8787
# HOST=0.0.0.0
